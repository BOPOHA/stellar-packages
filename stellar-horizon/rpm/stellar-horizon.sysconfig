## /etc/sysconfig/stellar-horizon
# This profile matches stellar-core-postgres-public.cfg. Horizon v29 uses
# Captive Core ingestion and no longer accepts STELLAR_CORE_DATABASE_URL.
NETWORK="pubnet"
DATABASE_URL="dbname=horizon user=stellar host=/var/run/postgresql"
STELLAR_CORE_URL="http://127.0.0.1:11626"
PORT=8000
PER_HOUR_RATE_LIMIT=9000
INGEST=true
