diff --git a/configure.ac b/configure.ac
--- a/configure.ac
+++ b/configure.ac
@@ -507,6 +507,23 @@ AC_ARG_ENABLE(tests,
         [Disable building test suite]))
 AM_CONDITIONAL(BUILD_TESTS, [test x$enable_tests != xno])
 
+AC_ARG_WITH([prebuilt-rust],
+    AS_HELP_STRING([--with-prebuilt-rust=PATH],
+        [Link a prebuilt librust_stellar_core.a and skip Cargo builds]),
+    [PREBUILT_RUST="$withval"],
+    [PREBUILT_RUST=""])
+AS_IF([test "x$PREBUILT_RUST" = "xyes"], [
+    AC_MSG_ERROR([--with-prebuilt-rust requires an archive path])
+])
+AS_IF([test "x$PREBUILT_RUST" = "xno"], [
+    PREBUILT_RUST=""
+])
+AS_IF([test -n "$PREBUILT_RUST" && test ! -f "$PREBUILT_RUST"], [
+    AC_MSG_ERROR([prebuilt Rust archive not found: $PREBUILT_RUST])
+])
+AC_SUBST(PREBUILT_RUST)
+AM_CONDITIONAL(USE_PREBUILT_RUST, [test -n "$PREBUILT_RUST"])
+
 AC_ARG_ENABLE(thread-jitter,
     AS_HELP_STRING([--enable-thread-jitter],
         [Enable thread jitter injection for finding concurrency bugs]))
@@ -589,5 +606,6 @@ AM_CONDITIONAL(ENABLE_NEXT_PROTOCOL_VERSION_UNSAFE_FOR_PRODUCTION,
     [test x$enable_next_protocol_version_unsafe_for_production = xyes])
 
+AS_IF([test -z "$PREBUILT_RUST"], [
 AC_PATH_PROG(CARGO, cargo)
 if test x"$CARGO" = x; then
   AC_MSG_ERROR([cannot find cargo, needed for rust code])
@@ -610,6 +628,7 @@ AX_COMPARE_VERSION([${RUSTC_VERSION}],[ge],[1.57],[],[
 ])
 AC_ARG_VAR(RUSTC)
 AC_ARG_VAR([RUSTC_WRAPPER], [rustc wrapper executable (for example, sccache)])
+])
 
 # Need this to pass through ccache/sccache for xdrpp, libsodium
 esc() {
diff --git a/src/Makefile.am b/src/Makefile.am
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -268,6 +268,10 @@ ALL_SOROBAN_EXTERN_ARGS=$(foreach proto,$(ALL_SOROBAN_PROTOCOLS),$(call soroban_
 ALL_SOROBAN_DEPEND_ARGS=$(foreach proto,$(ALL_SOROBAN_PROTOCOLS),$(call soroban_depend_flag,$(proto)))
 SOROBAN_LIBS_STATE=$(shell cat $(SOROBAN_LIBS_STAMP) 2>/dev/null || echo no-soroban-libs)
 
+if USE_PREBUILT_RUST
+LIBRUST_STELLAR_CORE=@PREBUILT_RUST@
+else # !USE_PREBUILT_RUST
+
 $(RUST_CXXBRIDGE): Makefile $(RUST_TOOLCHAIN_FILE)
 	mkdir -p $(RUST_BIN_DIR)
 	RUSTC_WRAPPER="$(RUSTC_WRAPPER)" CARGO_HTTP_MULTIPLEXING=false $(CARGO) install --force --locked --root $(RUST_BUILD_DIR) cxxbridge-cmd --version 1.0.68
@@ -469,6 +473,8 @@ $(LIBRUST_STELLAR_CORE): $(RUST_HOST_DEPFILES) $(SRC_RUST_FILES) $(ALL_SOROBAN_L
 
 endif # ENABLE_FASTDEV_UNSAFE_FOR_PRODUCTION
 
+endif # !USE_PREBUILT_RUST
+
 stellar_core_LDADD += $(LIBRUST_STELLAR_CORE) -ldl
 
 $(srcdir)/src.mk: $(top_srcdir)/make-mks
